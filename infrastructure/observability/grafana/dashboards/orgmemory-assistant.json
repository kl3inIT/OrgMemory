{
  "uid": "orgmemory-assistant",
  "title": "OrgMemory — Assistant",
  "tags": ["orgmemory", "assistant"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "What the person waiting experiences",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Time to first token",
      "description": "From the arriving question to the first token the caller sees — so it contains permission-scoped retrieval, an OpenFGA batch check and a canonical ledger re-read, which the user waits through. Spring AI's gen_ai.client.operation starts after all of that, so the two numbers answer different questions and neither is a fraction of the other.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, engine) (rate(orgmemory_assistant_time_to_first_token_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 · {{engine}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, engine) (rate(orgmemory_assistant_time_to_first_token_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 · {{engine}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, engine) (rate(orgmemory_assistant_time_to_first_token_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 · {{engine}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Turns that never emitted a token",
      "description": "A turn with no first token records no latency sample at all, so it cannot flatter the percentiles beside it. This is where those turns are counted instead.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(orgmemory_assistant_turn_milliseconds_count{started=\"false\"}[$__rate_interval])) / clamp_min(sum(rate(orgmemory_assistant_turn_milliseconds_count[$__rate_interval])), 1e-9)",
          "legendFormat": "never started"
        }
      ]
    },
    {
      "type": "row",
      "title": "How turns end",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }
    },
    {
      "type": "timeseries",
      "title": "Turns per second, by outcome",
      "description": "no_evidence is not a failure. The assistant saying it could not find accessible company knowledge is the permission model working, and counting it as an error makes a correctly scoped tenant look broken.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, engine) (rate(orgmemory_assistant_turn_milliseconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}} · {{engine}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Whole turn duration",
      "description": "First token to last. Compare against the panel above it: a turn that starts fast and finishes slowly is a generation problem, one that starts slowly is a retrieval problem.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orgmemory_assistant_turn_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orgmemory_assistant_turn_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
