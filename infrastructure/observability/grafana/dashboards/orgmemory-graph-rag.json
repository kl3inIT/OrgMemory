{
  "uid": "orgmemory-graph-rag",
  "title": "OrgMemory — GraphRAG pipeline",
  "tags": ["orgmemory", "graph-rag"],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "stage",
        "label": "Stage",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
        "query": "label_values(orgmemory_graph_rag_stage_milliseconds_count, stage)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Where time goes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Stage latency, p95",
      "description": "Thirteen stages, from parsing an upload to assembling the model context. A single slow stage is invisible in an end-to-end number; that is why the stage tag exists.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "calcs": ["lastNotNull", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(orgmemory_graph_rag_stage_milliseconds_bucket{stage=~\"$stage\"}[$__rate_interval])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage throughput",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(orgmemory_graph_rag_stage_milliseconds_count{stage=~\"$stage\"}[$__rate_interval]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "What is failing",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }
    },
    {
      "type": "timeseries",
      "title": "Failures per second, by code",
      "description": "The failure code is a bounded machine code, never an exception message — the telemetry boundary rejects free text. To see what actually happened, follow the trace.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, failure_code) (rate(orgmemory_graph_rag_stage_failures_total{stage=~\"$stage\"}[$__rate_interval]))",
          "legendFormat": "{{stage}} · {{failure_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outcome mix",
      "description": "An absent cache status is recorded as its own value rather than dropped, so a stage that does not cache is distinguishable from one whose cache stopped reporting.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, cache_status) (rate(orgmemory_graph_rag_stage_milliseconds_count{stage=~\"$stage\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}} · cache {{cache_status}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "What the model was given, and what it was refused",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 }
    },
    {
      "type": "timeseries",
      "title": "Context tokens per second, by channel",
      "description": "Where the prompt budget goes: system prompt, query, entities, relations, chunks. Counts only — the boundary permits the number and never the text it measured.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(orgmemory_graph_rag_context_tokens_total[$__rate_interval]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Assembled prompt size",
      "description": "A p95 climbing towards the budget is the warning that arrives before truncation starts, rather than after.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 0 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orgmemory_graph_rag_context_prompt_tokens_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orgmemory_graph_rag_context_prompt_tokens_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Evidence the budget refused",
      "description": "Two meters because they answer two questions. The truncation counter says how many answers were affected; the dropped counter says how much evidence was refused. One answer losing forty contributions and forty answers losing one are the same total and completely different problems.",
      "datasource": { "type": "prometheus", "uid": "orgmemory-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(orgmemory_graph_rag_context_truncations_total[$__rate_interval])",
          "legendFormat": "answers truncated /s"
        },
        {
          "refId": "B",
          "expr": "rate(orgmemory_graph_rag_context_dropped_contributions_total[$__rate_interval])",
          "legendFormat": "contributions dropped /s"
        }
      ]
    }
  ]
}
