# Copy to observability.env on the host and fill in. Never commit the filled file.
#
#   docker compose -f compose.observability.yaml --env-file observability.env up -d

# Grafana's local administrator. This is the only credential the stack has:
# Grafana is bound to loopback and reached over an SSH tunnel rather than
# published, and it is deliberately not behind Keycloak, whose database is the
# same PostgreSQL the product uses. See decision 0021.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3001

# Read-only monitoring role on the shared PostgreSQL. Do not reuse the
# application's credentials: an exporter needs pg_monitor and nothing else.
#   CREATE USER orgmemory_exporter WITH PASSWORD '...';
#   GRANT pg_monitor TO orgmemory_exporter;
POSTGRES_EXPORTER_DSN=postgresql://orgmemory_exporter:CHANGE_ME@postgres:5432/orgmemory?sslmode=disable

# Pins. Bump deliberately; an observability stack that silently moves is one you
# cannot correlate against its own history.
GRAFANA_IMAGE=grafana/grafana:13.1.1
PROMETHEUS_IMAGE=prom/prometheus:v3.13.2
LOKI_IMAGE=grafana/loki:3.7.4
TEMPO_IMAGE=grafana/tempo:3.0.2
ALLOY_IMAGE=grafana/alloy:v1.18.0

# Bounded on purpose. Without limits an observability stack becomes the outage.
PROMETHEUS_RETENTION_TIME=14d
PROMETHEUS_RETENTION_SIZE=8GB
GRAFANA_MEM_LIMIT=384m
PROMETHEUS_MEM_LIMIT=1024m
LOKI_MEM_LIMIT=512m
TEMPO_MEM_LIMIT=768m
ALLOY_MEM_LIMIT=384m

# --- Keycloak OIDC (realm orgmemory) ---------------------------------------
# Access is gated by the `observability` realm role, not by membership. A user
# Keycloak authenticates who lacks the role is refused, rather than admitted as
# a Viewer of telemetry that spans every organization. Grant it with:
#   kcadm.sh add-roles -r orgmemory --uusername <user> --rolename observability
GRAFANA_OIDC_ENABLED=true
GRAFANA_OIDC_CLIENT_ID=grafana
GRAFANA_OIDC_CLIENT_SECRET=
