# Immutable images built from one verified Git commit.
ORGMEMORY_API_IMAGE=ghcr.io/kl3init/orgmemory-api:sha-<commit>
ORGMEMORY_WORKER_IMAGE=ghcr.io/kl3init/orgmemory-worker:sha-<commit>
ORGMEMORY_MCP_IMAGE=ghcr.io/kl3init/orgmemory-mcp:sha-<commit>
ORGMEMORY_WEB_IMAGE=ghcr.io/kl3init/orgmemory-web:sha-<commit>
ORGMEMORY_KEYCLOAK_IMAGE=ghcr.io/kl3init/orgmemory-keycloak:sha-<commit>
ORGMEMORY_POSTGRES_IMAGE=ghcr.io/kl3init/orgmemory-postgres-rag:sha-<commit>

# Existing Docker networks on the ZM host.
ORGMEMORY_SHARED_INFRA_NETWORK=shared-infra
ORGMEMORY_PROXY_NETWORK=proxy-network

# Existing shared PostgreSQL administrator. Keep values only in the server's
# mode-0600 .env.production file.
SHARED_POSTGRES_ADMIN_USER=
SHARED_POSTGRES_ADMIN_PASSWORD=

ORGMEMORY_DB_NAME=orgmemory
ORGMEMORY_DB_USER=orgmemory
ORGMEMORY_DB_PASSWORD=

OPENFGA_DB_NAME=openfga
OPENFGA_DB_USER=openfga
OPENFGA_DB_PASSWORD=
# URL-encode special characters in the password.
OPENFGA_DATASTORE_URI=postgres://openfga:<url-encoded-password>@postgres:5432/openfga?sslmode=disable
ORGMEMORY_OPENFGA_STORE_ID=
ORGMEMORY_OPENFGA_AUTHORIZATION_MODEL_ID=
# SHA-256 of the repository model pinned by the model ID above. The bootstrap
# and deployment scripts own this value.
ORGMEMORY_OPENFGA_MODEL_SHA256=

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
ORGMEMORY_OIDC_CLIENT_SECRET=
ORGMEMORY_SCIM_VERIFIER_KEY=
ORGMEMORY_SCIM_VERIFIER_KEY_VERSION=1
ORGMEMORY_SCIM_PREVIOUS_VERIFIER_KEYS=
ORGMEMORY_SCIM_MAXIMUM_REQUEST_SIZE=256KB
ORGMEMORY_SCIM_REQUESTS_PER_MINUTE=120
ORGMEMORY_SCIM_TOKEN_TTL=90d
ORGMEMORY_SCIM_ROTATION_OVERLAP=15m
ORGMEMORY_MCP_RESOURCE_URI=https://om.kl3in.tech/mcp
ORGMEMORY_MCP_AUDIENCE=https://om.kl3in.tech/mcp
ORGMEMORY_MCP_API_AUDIENCE=orgmemory-web
ORGMEMORY_MCP_OIDC_CLIENT_ID=orgmemory-mcp
ORGMEMORY_MCP_OIDC_CLIENT_SECRET=
ORGMEMORY_MCP_RATE_LIMIT_ENABLED=true
ORGMEMORY_MCP_GLOBAL_RATE_CAPACITY=800
ORGMEMORY_MCP_GLOBAL_RATE_WINDOW=1m
ORGMEMORY_MCP_CALLER_RATE_CAPACITY=120
ORGMEMORY_MCP_CALLER_RATE_WINDOW=1m
ORGMEMORY_MCP_CALLER_RATE_EXPIRY=15m
ORGMEMORY_MCP_MAX_TRACKED_CALLERS=10000
ORGMEMORY_MCP_MAX_BODY_BYTES=262144
ORGMEMORY_SKILL_PUBLICATION_MAX_BODY_BYTES=23068672
ORGMEMORY_CONNECTOR_SCHEDULING_ENABLED=true
ORGMEMORY_CONNECTOR_POLL_INTERVAL=30s

ORGMEMORY_OBJECT_STORAGE_ACCESS_KEY=
ORGMEMORY_OBJECT_STORAGE_SECRET_KEY=
ORGMEMORY_OBJECT_STORAGE_BUCKET=orgmemory-evidence

ORGMEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
ORGMEMORY_OPENAI_API_KEY=
ORGMEMORY_OPENAI_MODEL=gpt-5.6-sol
ORGMEMORY_KEYWORD_MODEL=gpt-5.6-sol
ORGMEMORY_GRAPH_QUERY_KEYWORD_CACHE_TTL=24h
ORGMEMORY_GRAPH_QUERY_MAXIMUM_CONCURRENT_SPACES=4
ORGMEMORY_GRAPH_EXTRACTION_MODEL=gpt-5.6-sol
ORGMEMORY_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ORGMEMORY_OPENAI_EMBEDDING_DIMENSIONS=1536

# Generate independent random values; do not reuse provider/database secrets.
ORGMEMORY_SECRETS_KEY=
ORGMEMORY_SECRETS_SALT=
ORGMEMORY_SECRETS_KEY_VERSION=1

# POC diagnostics. Set ORGMEMORY_APP_LOG_LEVEL=INFO after the pilot.
ORGMEMORY_ROOT_LOG_LEVEL=INFO
ORGMEMORY_APP_LOG_LEVEL=DEBUG
ORGMEMORY_SECURITY_LOG_LEVEL=INFO
ORGMEMORY_SQL_LOG_LEVEL=INFO
ORGMEMORY_HEALTH_SHOW_DETAILS=always
OPENFGA_LOG_LEVEL=info
OPENFGA_DATASTORE_MAX_OPEN_CONNS=12
OPENFGA_DATASTORE_MIN_OPEN_CONNS=2
OPENFGA_DATASTORE_MAX_IDLE_CONNS=8
KEYCLOAK_LOG_LEVEL=INFO

# Match the owner of ORGMEMORY_BACKUP_DIRECTORY on the deployment host.
ORGMEMORY_BACKUP_UID=1000
ORGMEMORY_BACKUP_GID=1000

# Keep false for the first private-network start. Set true after both Nginx
# Proxy Manager hosts and certificates work.
ORGMEMORY_REQUIRE_PUBLIC_SMOKE=false
