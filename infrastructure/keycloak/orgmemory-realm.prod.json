{
  "realm": "orgmemory",
  "enabled": true,
  "displayName": "OrgMemory",
  "loginTheme": "orgmemory-shadcn",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "clientScopes": [
    {
      "name": "assets:read",
      "description": "Read authorized released OrgMemory Assets through MCP and the canonical API",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "true",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "orgmemory-mcp-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${ORGMEMORY_MCP_RESOURCE_URI}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "orgmemory-mcp-exchange-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orgmemory-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
      }
      ]
    },
    {
      "name": "assets:write",
      "description": "Create governed OrgMemory Asset drafts through an authenticated publication adapter",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "true",
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "orgmemory-mcp-publication-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "${ORGMEMORY_MCP_RESOURCE_URI}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "orgmemory-mcp-publication-exchange-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orgmemory-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "orgmemory-web",
      "name": "OrgMemory Web",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORGMEMORY_OIDC_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "rootUrl": "https://om.kl3in.tech",
      "baseUrl": "https://om.kl3in.tech",
      "adminUrl": "https://om.kl3in.tech",
      "redirectUris": [
        "https://om.kl3in.tech/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "https://om.kl3in.tech"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://om.kl3in.tech/login"
      },
      "protocolMappers": [
        {
          "name": "orgmemory-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "orgmemory-web",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "orgmemory-mcp",
      "name": "OrgMemory MCP token-exchange gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "${ORGMEMORY_MCP_OIDC_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
    "attributes": {
      "standard.token.exchange.enabled": "true"
    },
    "protocolMappers": [
      {
        "name": "orgmemory-api-downstream-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": {
          "included.client.audience": "orgmemory-web",
          "id.token.claim": "false",
          "access.token.claim": "true",
          "introspection.token.claim": "true"
        }
      }
    ],
    "optionalClientScopes": [
      "assets:read",
      "assets:write"
      ]
    }
  ]
}
