model
  schema 1.1

type user

type service_account

type group
  relations
    define member: [user, service_account]

type organization
  relations
    define member: [user, service_account, group#member]
    define administrator: [user, group#member]
    define knowledge_reader: [user, group#member]
    define knowledge_contributor: [user, group#member]
    define knowledge_reviewer: [user, group#member]
    define knowledge_curator: [user, group#member]
    define source_manager: [user, group#member]
    define can_manage_members: administrator
    define can_manage_sources: source_manager or administrator
    define can_manage_ai: administrator
    define can_create_knowledge_space: administrator
    define can_search_knowledge: knowledge_reader or member or administrator
    define can_view_directory: member
    define can_view_audit: administrator
    define can_curate_graph: knowledge_curator or administrator

type organizational_unit
  relations
    define organization: [organization]
    define member: [user, service_account, group#member]
    define manager: [user, group#member]
    define org_admin: administrator from organization

    define can_manage: manager or org_admin

type knowledge_space
  relations
    define organization: [organization]
    define organizational_unit: [organizational_unit]
    define viewer: [user, group#member, organization#member, organization#knowledge_reader, organizational_unit#member]
    define contributor: [user, group#member, organization#knowledge_contributor, organizational_unit#member]
    define reviewer: [user, group#member, organization#knowledge_reviewer, organizational_unit#manager]
    define administrator: [user, group#member]
    define org_admin: administrator from organization

    define can_manage_acl: administrator or org_admin
    define can_publish: reviewer
    define can_curate_graph: can_publish
    define can_export_graph: can_publish
    define can_create_asset: contributor
    define can_view: viewer

type knowledge_asset
  relations
    define space: [knowledge_space]
    define owner: [user]
    define viewer: [user, group#member]
    define editor: [user, group#member]
    define reviewer: [user, group#member]
    define administrator: [user, group#member]

    define can_manage_acl: administrator or can_manage_acl from space
    define can_delete: owner or can_manage_acl
    define can_publish: reviewer or can_publish from space or can_manage_acl
    define can_rebuild: can_publish
    define can_edit: editor or can_delete
    define can_view: viewer or can_view from space

type asset
  relations
    define organization: [organization]
    define space: [knowledge_space]
    define owner: [user]
    define backup_owner: [user]
    define steward: [user, group#member]
    define viewer: [user, group#member, organization#member]
    define editor: [user, group#member]
    define reviewer: [user, group#member]
    define publisher: [user, group#member]
    define org_admin: administrator from organization

    define can_manage_sharing: (owner and can_create_asset from space) and can_view from space
    define can_transfer_ownership: can_manage_sharing
    define can_edit_draft: ((editor or owner) and can_create_asset from space) and can_view from space
    define can_publish_direct: can_manage_sharing
    define can_view_governance_history: (editor or owner or org_admin) and can_view from space
    define can_view_released: (viewer or editor or owner or org_admin) and can_view from space
    define can_recover_ownership: org_admin and can_manage_acl from space
    define can_emergency_withdraw: can_recover_ownership

    define can_manage_roles: can_manage_sharing
    define can_edit: can_edit_draft
    define can_submit_review: can_edit_draft
    define can_publish_skill: can_publish_direct
    define can_review: (reviewer or org_admin) and can_publish from space
    define can_publish: (publisher or org_admin) and can_publish from space
    define can_withdraw: can_manage_sharing
    define can_view: can_view_released
    define can_use: can_view_released

type source_connection
  relations
    define organization: [organization]
    define manager: [user, group#member, organization#source_manager]
    define ingestor: [service_account]
    define org_admin: administrator from organization

    define can_manage: manager or org_admin
    define can_ingest: ingestor or can_manage
