{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orgmemory.com/contracts/connector/crawl-batch.schema.json",
  "title": "Connector Crawl Batch",
  "description": "One crawl batch a connector hands to ConnectorIngestionService. The envelope carries the tenant, source connection, target Knowledge Space, an opaque resume cursor, whether the crawl was exhaustive, and the four separately-versioned payload kinds plus tombstones. An unknown payload version is rejected (fail closed).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organizationId",
    "sourceSystem",
    "sourceConnectionKey",
    "knowledgeSpaceId",
    "actorUserId",
    "crawlCursor",
    "versions",
    "componentStates"
  ],
  "properties": {
    "organizationId": { "type": "string", "format": "uuid" },
    "sourceSystem": { "type": "string", "minLength": 1, "examples": ["slack"] },
    "sourceConnectionKey": { "type": "string", "minLength": 1, "description": "Workspace/connection id within the source system." },
    "knowledgeSpaceId": { "type": "string", "format": "uuid" },
    "actorUserId": { "type": "string", "format": "uuid", "description": "Connection owner recorded as author, publication owner, and audit actor." },
    "crawlCursor": { "type": "string", "minLength": 1, "description": "Opaque per-connection idempotency/resume marker owned by the batch producer." },
    "versions": { "$ref": "#/$defs/versions" },
    "componentStates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/componentState" },
      "description": "Independent source cursor and completeness evidence for each component carried by this batch."
    },
    "identities": { "type": "array", "items": { "$ref": "#/$defs/identity" }, "default": [] },
    "memberships": { "type": "array", "items": { "$ref": "#/$defs/membership" }, "default": [] },
    "contents": { "type": "array", "items": { "$ref": "#/$defs/content" }, "default": [] },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" }, "default": [] },
    "tombstones": { "type": "array", "items": { "$ref": "#/$defs/tombstone" }, "default": [] },
    "crawlComplete": {
      "type": "boolean",
      "default": false,
      "description": "Whether contents and permissions together enumerate every object this connection currently has at the source. Only a batch that claims this may retire what it did not mention; pruning against a partial, interrupted, or single-channel crawl would retire the whole connection. Absent means no."
    }
  },
  "$defs": {
    "componentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "cursor", "captureStatus"],
      "properties": {
        "component": { "type": "string", "enum": ["CONTENT", "PERMISSION", "MEMBERSHIP"] },
        "cursor": { "type": "string", "minLength": 1 },
        "captureStatus": { "type": "string", "enum": ["COMPLETE", "INCOMPLETE"] },
        "incompleteReason": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "captureStatus": { "const": "COMPLETE" } } },
          "then": { "properties": { "incompleteReason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "captureStatus": { "const": "INCOMPLETE" } } },
          "then": {
            "required": ["incompleteReason"],
            "properties": { "incompleteReason": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "identity", "membership", "permission"],
      "properties": {
        "content": { "type": "string", "const": "content/v1" },
        "identity": { "type": "string", "const": "identity/v2" },
        "membership": { "type": "string", "const": "membership/v1" },
        "permission": { "type": "string", "const": "permissions/v1" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nativePrincipalId"],
      "properties": {
        "kind": { "type": "string", "enum": ["SOURCE_USER", "SOURCE_GROUP"] },
        "nativePrincipalId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable source-owned principal id. Email and display name are aliases, never authorization keys."
        },
        "email": { "type": ["string", "null"] },
        "displayName": { "type": ["string", "null"] },
        "ssoVerified": { "type": "boolean", "default": false },
        "idpIssuer": { "type": ["string", "null"] },
        "idpSubject": { "type": ["string", "null"] }
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupNativePrincipalId", "captureStatus", "members"],
      "properties": {
        "groupNativePrincipalId": { "type": "string", "minLength": 1 },
        "captureStatus": { "type": "string", "enum": ["COMPLETE", "INCOMPLETE"] },
        "incompleteReason": { "type": ["string", "null"] },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/membershipMember" },
          "default": []
        }
      },
      "allOf": [
        {
          "if": { "properties": { "captureStatus": { "const": "COMPLETE" } } },
          "then": { "properties": { "incompleteReason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "captureStatus": { "const": "INCOMPLETE" } } },
          "then": {
            "required": ["incompleteReason"],
            "properties": { "incompleteReason": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "membershipMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "nativePrincipalId"],
      "properties": {
        "kind": { "type": "string", "enum": ["SOURCE_USER", "SOURCE_GROUP"] },
        "nativePrincipalId": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalObjectId", "title", "body", "contentRevision"],
      "properties": {
        "externalObjectId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "contentRevision": { "type": "string", "minLength": 1, "description": "Source revision marker; the sole content idempotency key." }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalObjectId", "grants"],
      "properties": {
        "externalObjectId": { "type": "string", "minLength": 1 },
        "grants": { "type": "array", "items": { "$ref": "#/$defs/grant" } }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalKind", "principalNativeId", "gate"],
      "properties": {
        "principalKind": { "type": "string", "enum": ["SOURCE_USER", "SOURCE_GROUP"] },
        "principalNativeId": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "enum": ["ALLOW", "DENY"] }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalObjectId"],
      "properties": {
        "externalObjectId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
