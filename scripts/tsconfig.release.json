{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "check-publish-lock.mts",
    "tegami-config.mts",
    "tegami.mts",
    "tegami-product.mts",
    "tegami-product.test.mts"
  ]
}
