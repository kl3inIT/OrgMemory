{
  "name": "@orgmemory/docs",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "check:content": "node scripts/check-docs.mjs content",
    "check:manifest": "node scripts/check-docs.mjs manifest",
    "check:publication": "node scripts/check-docs.mjs publication",
    "check": "pnpm lint && pnpm typecheck && pnpm check:content && pnpm check:manifest && pnpm check:publication",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint"
  },
  "dependencies": {
    "cnfast": "^0.0.8",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.13.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "oxlint": "^1.74.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.9.0"
