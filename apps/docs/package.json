{
  "name": "@orgmemory/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm check:api && next build",
    "dev": "next dev",
    "start": "next start",
    "generate:api": "tsx scripts/generate-openapi.ts",
    "check:api": "tsx scripts/generate-openapi.ts --check",
    "check:output": "node scripts/check-build-output.mjs",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "check:content": "node scripts/check-docs.mjs content",
    "check:manifest": "node scripts/check-docs.mjs manifest",
    "check:publication": "node scripts/check-docs.mjs publication",
    "check:routes": "node scripts/check-docs.mjs routes",
    "check:links": "tsx scripts/check-links.ts",
    "test:e2e": "pnpm build && node scripts/prepare-standalone-test.mjs && playwright test",
    "check": "pnpm check:api && pnpm lint && pnpm typecheck && pnpm check:content && pnpm check:manifest && pnpm check:publication && pnpm check:routes && pnpm check:links",
    "postinstall": "fumadocs-mdx",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fastify/deepmerge": "3.2.1",
    "@scalar/openapi-upgrader": "0.2.9",
    "cnfast": "^0.0.8",
    "fast-content-type-parse": "3.0.0",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-openapi": "11.2.2",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.13.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "4.3.1",
    "xml-js": "1.6.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "next-validate-link": "1.6.6",
    "oxlint": "^1.74.0",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.9.0"
}
