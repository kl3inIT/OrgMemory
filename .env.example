# Copy to .env for the default GraphRAG runtime. To boot without a model
# provider, set both model selectors to none and explicitly select
# ORGMEMORY_ASSISTANT_RETRIEVAL_ENGINE=CANONICAL_HYBRID.
OPENAI_API_KEY=sk-...
ORGMEMORY_AI_MODEL_CHAT=openai
ORGMEMORY_AI_MODEL_EMBEDDING=openai
ORGMEMORY_ASSISTANT_RETRIEVAL_ENGINE=GRAPH_RAG
ORGMEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
ORGMEMORY_OPENAI_MODEL=gpt-5.6-sol
ORGMEMORY_GRAPH_EXTRACTION_CONCURRENCY=4
ORGMEMORY_GRAPH_EXTRACTION_MODEL=gpt-5.6-sol
ORGMEMORY_GRAPH_INDEXING_ENABLED=true

ORGMEMORY_POSTGRES_PORT=15432
ORGMEMORY_DB_URL=jdbc:postgresql://localhost:15432/orgmemory
ORGMEMORY_DB_USER=orgmemory
ORGMEMORY_DB_PASSWORD=orgmemory
ORGMEMORY_API_PORT=8080
ORGMEMORY_MCP_PORT=8090
ORGMEMORY_MCP_RESOURCE_URI=http://localhost:8090/mcp
ORGMEMORY_MCP_AUDIENCE=http://localhost:8090/mcp
ORGMEMORY_MCP_API_AUDIENCE=orgmemory-web
ORGMEMORY_MCP_OIDC_CLIENT_ID=orgmemory-mcp
ORGMEMORY_MCP_OIDC_CLIENT_SECRET=
ORGMEMORY_MCP_CONNECT_TIMEOUT=5s
ORGMEMORY_MCP_REQUEST_TIMEOUT=75s
ORGMEMORY_SCIM_VERIFIER_KEY=replace-with-unpadded-base64url-32-byte-key
ORGMEMORY_SCIM_VERIFIER_KEY_VERSION=1
ORGMEMORY_SCIM_PREVIOUS_VERIFIER_KEYS=
ORGMEMORY_SCIM_MAXIMUM_REQUEST_SIZE=256KB
ORGMEMORY_SCIM_REQUESTS_PER_MINUTE=120
ORGMEMORY_SCIM_TOKEN_TTL=90d
ORGMEMORY_SCIM_ROTATION_OVERLAP=15m
ORGMEMORY_MCP_RATE_LIMIT_ENABLED=true
ORGMEMORY_MCP_GLOBAL_RATE_CAPACITY=800
ORGMEMORY_MCP_GLOBAL_RATE_WINDOW=1m
ORGMEMORY_MCP_CALLER_RATE_CAPACITY=120
ORGMEMORY_MCP_CALLER_RATE_WINDOW=1m
ORGMEMORY_MCP_CALLER_RATE_EXPIRY=15m
ORGMEMORY_MCP_MAX_TRACKED_CALLERS=10000
ORGMEMORY_MCP_MAX_BODY_BYTES=262144
ORGMEMORY_SKILL_PUBLICATION_MAX_BODY_BYTES=23068672
ORGMEMORY_CONNECTOR_SCHEDULING_ENABLED=true
ORGMEMORY_CONNECTOR_POLL_INTERVAL=30s

# Generate separate local object-storage credentials; never reuse production values.
ORGMEMORY_OBJECT_STORAGE_ACCESS_KEY=replace-with-local-minio-user
ORGMEMORY_OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-local-secret
